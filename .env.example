PORT=3000
MONGODB_URI=mongodb://cuties:cuties@127.0.0.1:27017/cuties?authSource=admin
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@cuties.store
ADMIN_PASSWORD=replace-me
ALLOWED_ORIGINS=http://localhost:8443

# Docker Compose reads these. The container uses host "mongo", not 127.0.0.1.
MONGO_USER=cuties
MONGO_PASSWORD=cuties
